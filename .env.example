# ============================================================================
# CONFIGURAÇÃO DO BANCO DE DADOS E AUTENTICAÇÃO (SUPABASE / POSTGRESQL)
# Copie este arquivo para `.env` e preencha com os dados do seu projeto Supabase
# ============================================================================

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_PUBLICA_DO_SUPABASE

# ID padrão da Loja quando operando em modo Single-Tenant (Alpha e Ômega Nº 3402)
VITE_DEFAULT_LOJA_ID=00000000-0000-0000-0000-000000003402

